    "grunt": "^0.4.4",
    "grunt-cli": "^1.5.0",
    "grunt-contrib-coffee": "^0.10.1",
    "grunt-contrib-compass": "^0.7.2",
    "grunt-contrib-concat": "^0.3.0",
    "grunt-contrib-watch": "^0.6.0",
    "grunt-typescript": "^0.8.0",
    "matchdep": "^0.3.0"
  }
}
